# ─── Trovly env template ─────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# In Streamlit Cloud, set these as secrets in the app dashboard.

# ─── Notifications ───────────────────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# ─── Billing ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CAREER_HUNTER_PRICE_ID=
STRIPE_OFFER_ACCELERATOR_PRICE_ID=

# ─── Job source APIs ─────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# ─── Runtime (optional) ──────────────────────────────────────
# TROVLY_ENV: dev | staging | prod  (controls log level + feature flags)
TROVLY_ENV=dev
LOG_LEVEL=INFO
